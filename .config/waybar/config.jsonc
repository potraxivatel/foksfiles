{
    "layer": "top",
    "position": "top",
    "height": 30,
    "spacing": 0,

    "modules-left": ["sway/workspaces", "mpris", "sway/mode"],
    "modules-center": ["custom/clock"],
    "modules-right": ["sway/language", "custom/volume", "cpu", "memory", "tray"],

    "sway/workspaces": {
        "disable-scroll": true,
        "format": "{icon}{name}",
        "format-icons": {
            "default": " ",
            "urgent": "!",
            "focused": "*"
        }
    },

    "mpris": {
        "format": "<span color='#6b7560'>[ </span><span color='#8a9164'><b>music:</b></span> {artist} - {title}<span color='#6b7560'> ]</span>",
        "format-paused": "<span color='#6b7560'>[ </span><span color='#8a9164'><b>paused:</b></span> {artist} - {title}<span color='#6b7560'> ]</span>",
        "max-length": 40,
        "artist-len": 15,
        "title-len": 20
    },

    "sway/mode": {
        "format": "  {}"
    },

    "custom/clock": {
        "format": "<span color='#6b7560'>[ </span>{text}<span color='#6b7560'> ]</span>",
        "exec": "date +'%H:%M %A, %b %d' | awk '{print tolower($0)}'",
        "interval": 3
    },

    "sway/language": {
        "format": "<span color='#6b7560'>[ </span><span color='#8a9164'><b>key:</b></span> {short}<span color='#6b7560'> / </span>",
        "tooltip": false
    },

    "custom/volume": {
        "format": "<span color='#8a9164'><b>vol:</b></span> {}",
        "exec": "/home/void/.local/bin/vol-status",
        "return-type": "json",
        "interval": 1,
        "on-click": "/home/void/.local/bin/vol-toggle",
        "scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.03+ -l 1.0",
        "scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.03-"
    },

    "cpu": {
        "format": "<span color='#6b7560'> / </span><span color='#8a9164'><b>cpu:</b></span> {usage}%",
        "interval": 3
    },

    "memory": {
        "format": "<span color='#6b7560'> / </span><span color='#8a9164'><b>ram:</b></span> {percentage}%",
        "interval": 5
    },

    "tray": {
        "icon-size": 18,
        "spacing": 6,
        "tooltip": false
    }
}
